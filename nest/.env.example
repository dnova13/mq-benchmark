# 복사해서 .env로 쓴다. 값이 없으면 src/config/*.config.ts의 기본값을 쓴다.
PORT=3000

# MQ on/off (false면 해당 모듈을 로드하지 않는다)
MQ_KAFKA_ENABLED=true
MQ_RABBITMQ_ENABLED=true
MQ_REDIS_ENABLED=true

# MariaDB
DB_HOST=localhost
DB_PORT=33307
DB_USER=root
DB_PASSWORD=1234
DB_NAME=bench
DB_POOL_SIZE=10

# Kafka
KAFKA_CLIENT_ID=bench-nest
KAFKA_BROKERS=localhost:39092
KAFKA_TOPIC=bench-topic
KAFKA_PARTITIONS=10
KAFKA_REPLICATION_FACTOR=1
KAFKA_GROUP_ID=bench-nest-group
KAFKA_CONSUMER_CONCURRENCY=10
KAFKA_SESSION_TIMEOUT_MS=60000

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:35672
RABBITMQ_QUEUE=bench-queue
RABBITMQ_DURABLE=true
RABBITMQ_PERSISTENT=true
RABBITMQ_PREFETCH=100

# Redis Streams
REDIS_HOST=localhost
REDIS_PORT=36397
REDIS_STREAM_KEY=bench:stream
REDIS_GROUP=bench-nest-group
REDIS_WORKERS=10
REDIS_BATCH_SIZE=100
REDIS_BLOCK_MS=1000
